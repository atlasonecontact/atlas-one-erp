# Copy this file to .env.local and fill values
# Windows PowerShell: Copy-Item .env.local.example .env.local

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED for server-side admin endpoints (employee creation + demo provisioning)
# IMPORTANT: keep this secret. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL: demo password used by /demo (must be >= 6 chars)
# If unset, defaults to Demo123456!
DEMO_PASSWORD=

# Notifications (optional, depending on what you enable)
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
